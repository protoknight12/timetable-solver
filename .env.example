# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=

# Postgres (adjust user, password, host and database name to your setup)
DATABASE_URL=postgresql+psycopg://user:change-me@localhost:5432/timetable

# Redis (use redis://redis:6379/0 when running inside Docker Compose)
REDIS_URL=redis://localhost:6379/0

# LLM (only used to turn text into PROPOSED constraints)
# With LLM_ENABLED=false the text input is hidden and only the manual form is shown.
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_ENABLED=false

# Solver
SOLVER_TIME_LIMIT_S=60
