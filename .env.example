# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=

# `flask` reads this file itself (python-dotenv); Docker Compose passes it in.

# Database. Postgres (adjust user, password, host and database name to your setup)
DATABASE_URL=postgresql+psycopg://user:change-me@localhost:5432/timetable
# Local dev without Postgres: a SQLite file in instance/ (then run `flask --app app db upgrade`).
# DATABASE_URL=sqlite:///saturn.db

# Password of the Compose database (docker-compose.yml). install.sh generates it; set it before the first `docker compose up`.
POSTGRES_PASSWORD=

# Redis (use redis://redis:6379/0 when running inside Docker Compose).
# Without Redis locally: leave it empty and set SOLVE_INLINE=true below.
REDIS_URL=redis://localhost:6379/0

# LLM (only used to turn text into PROPOSED constraints)
# With LLM_ENABLED=false the text input is hidden and only the manual form is shown.
ANTHROPIC_API_KEY=
# Empty = claude-sonnet-5-5. Set a hard monthly spend limit on the key in the Anthropic console.
LLM_MODEL=
LLM_ENABLED=false

# Reverse-proxy hops to trust for X-Forwarded-For/Proto/Host (client IP for rate limits, https links).
# 0 = none (local dev). Compose sets 1 for `web` (Caddy). Never > 0 without a proxy: clients could spoof their IP.
TRUSTED_PROXIES=0

# Solver
SOLVER_TIME_LIMIT_S=60
# Local dev only (no Redis or RQ worker, e.g. Windows): solve inside the web process.
# Leave false in production; Docker Compose runs the RQ worker.
SOLVE_INLINE=false

# Demo accounts created by `flask seed` ("admin" = Администратор, "preglad" = Преглед).
# Skipped when empty. Choose real passwords here, never commit them.
DEMO_ADMIN_PASSWORD=
DEMO_VIEWER_PASSWORD=
# Other accounts: flask --app app create-user NAME --role admin|viewer [--password-env VAR]

# Optional key for the read-only REST API (/api/v1). Other systems send it as
# "Authorization: Bearer <API_TOKEN>". Leave empty to allow only logged-in users.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
